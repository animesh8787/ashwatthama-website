# Firebase Configuration — Copy these values from your Firebase Console
# Project Settings → General → Your apps → Web app → SDK configuration

NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Backend API base URL for the Next.js website client
# For local cross-domain cookie testing with hosts file:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8765/api/v1
# For production:
# NEXT_PUBLIC_API_BASE_URL=https://api.ashwatthama.dev/api/v1

# Dashboard URL for CTA redirects (must match cookie domain)
# For local testing:
NEXT_PUBLIC_DASHBOARD_URL=http://dashboard.ashwatthama.local:5173
# For production:
# NEXT_PUBLIC_DASHBOARD_URL=https://dashboard.ashwatthama.dev
